# ==============================================================================
# FUNDAMICS LMS FRONTEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Client-side variables are public in browser bundles.
# NEVER place database credentials, JWT secrets, or server API keys here.
# ==============================================================================

# FastAPI Backend API Configuration
# Local Development: http://127.0.0.1:8000/api/v1
# Render Test/Preview: https://<render-service-name>.onrender.com/api/v1
# Production: https://api.fundamics.in/api/v1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Mock API toggle (Set to 'true' to force offline mock fixtures)
EXPO_PUBLIC_USE_MOCK=false

# Application Environment ('development' | 'preview' | 'production')
APP_ENV=development
